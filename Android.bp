// Unmodified OS4 camera engines loaded dynamically by the retained camera nodes.
cc_prebuilt_library_shared {
    stl: "none",
    enabled: select(soong_config_variable("warsaw_stock_abi", "enabled"), {
        "true": true,
        default: false,
    }),
    name: "libmlremosaicengine",
    owner: "xiaomi",
    strip: { none: true },
    target: {
        android_arm64: {
            srcs: ["proprietary/odm/lib64/libmlremosaicengine.so"],
            shared_libs: [
                "libcamxcommonutils",
                "libcutils",
                "liblog",
                "libcdsprpc",
                "libsync",
                "libbitmlenginev2",
                "libz",
                "libc++",
                "libc",
                "libm",
                "libdl",
            ],
        },
    },
    compile_multilib: "64",
    prefer: true,
    device_specific: true,
}

