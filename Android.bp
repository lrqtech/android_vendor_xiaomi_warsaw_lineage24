// Original OTA JNI entry points for Qualcomm framework detection.
cc_prebuilt_library_shared {
    name: "libvndfwk_detect_jni.qti",
    source_module_name: "libvndfwk_detect_jni.qti",
    prefer: true,
    stem: "libvndfwk_detect_jni.qti",
    owner: "xiaomi",
    system_ext_specific: true,
    vendor_available: true,
    compile_multilib: "64",
    stl: "none",
    strip: { none: true },
    target: {
        vendor: {
            srcs: ["proprietary/vendor/lib64/libvndfwk_detect_jni.qti.so"],
            shared_libs: ["libqti_vndfwk_detect", "libcutils", "libutils", "liblog", "libc++", "libc", "libm", "libdl"],
