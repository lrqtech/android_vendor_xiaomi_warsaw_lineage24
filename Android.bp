// OS4 cloud provider, updater and rollback with the original DEX and resources.
android_app_import {
    enabled: select(soong_config_variable("warsaw_stock_abi", "enabled"), {
        "true": true,
        default: false,
    }),
    name: "WarsawCloudSettings",
    owner: "xiaomi",
    apk: "proprietary/system_ext/priv-app/WarsawCloudSettings/WarsawCloudSettings.apk",
    certificate: "platform",
    privileged: true,
    system_ext_specific: true,
    overrides: ["HTMLViewer"],
    uses_libs: ["org.apache.http.legacy", "//device/xiaomi/warsaw:miui-cameraopt"],
    enforce_uses_libs: true,
}

